# -------------------- ALIAS --------------------
if command -v batcat &> /dev/null; then
  alias cat="batcat"
  alias bat="batcat"
elif command -v bat &> /dev/null; then
  alias cat="bat"
else
  alias cat="cat"
fi

if command -v eza &> /dev/null; then
  alias ls="eza --icons=always --sort=extension"
else
  alias ls="ls"
fi

# alias cd='z'
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
alias b='~/notes/brg.sh'
alias cal='calcurse -D ~/dev/calendar'
alias dbdev="pgcli -h $DB_DEV_HOST -p 5432 -U hub -d hubDB-dev"
alias dbprod="pgcli -h $DB_PROD_HOST -p 5432 -U hub -d hubDB-prod"
alias dot='cd ~/dotfiles'
alias g=git
alias hs='cd ~/dev/tarken/hub-server'
alias hw='cd ~/dev/tarken/hub-web-client'
alias pomo='~/dotfiles/scripts/pomo.sh'
alias setup='~/dotfiles/scripts/setup.sh'
alias tarken='cd ~/dev/tarken'
alias tks="tmux kill-session -t"
alias vault='cd ~/vault'
alias shll='ps -p $$'
alias vim='nvim'
alias tk='npx tenkai'


# ---------- MISCELLANEOUS --------------------
# Quote of the day, cached: fetching it inline cost ~0.5s on every new shell/tmux pane.
# A stale cache triggers a detached refresh, so the new quote shows from the next shell on.
_quote_cache=~/.cache/quote-of-the-day
if [ "$(date -r "$_quote_cache" +%F 2>/dev/null)" != "$(date +%F)" ]; then
    # outer subshell keeps the job out of the shell's job table (no "[1] pid" noise)
    ( (
        tmp="$_quote_cache.$$"
        curl -s -m 5 https://zenquotes.io/api/today | jq -r '.[0].q + " — " + .[0].a' >"$tmp" 2>/dev/null &&
            [ -s "$tmp" ] && mv -f "$tmp" "$_quote_cache"
        rm -f "$tmp"
    ) >/dev/null 2>&1 & )
fi
[ -s "$_quote_cache" ] && echo "✨ $(<"$_quote_cache")"
unset _quote_cache


